# MongoDB / Prisma
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/quizvera?retryWrites=true&w=majority"

# Auth.js v5
AUTH_SECRET="generate-a-random-secret-of-at-least-32-bytes"
CRON_SECRET="random-secret-for-quiz-expiry-scheduler"
AUTH_TRUST_HOST="true"
# Keep aligned with your local dev port
NEXTAUTH_URL="http://localhost:3020"
NEXT_PUBLIC_APP_URL="http://localhost:3020"

# Google OAuth (optional if Google sign-in is not used)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_FOLDER_NAME="uiz"

# Email for password reset and quiz result delivery
SENDER_NAME="Quizvera"
SENDER_ADDRESS="no-reply@example.com"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""

# Optional external translation endpoint; current product translates to Hindi
NEXT_PUBLIC_TRANSLATION_API=""

# Generative AI
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Used only by any legacy JWT helpers still in use. Prefer AUTH_SECRET for app auth.
JWT_SECRET=""
