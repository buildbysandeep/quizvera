// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum QuizAvailabilityMode {
  ALWAYS
  PUBLISH_TIMER
  MANUAL_TIMER
  FIXED_WINDOW
}

model User {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  image         String?
  imagePublicId String?
  email         String  @unique
  phone         String?
  passwordHash  String?
  googleId      String?
  role          Role[]  @default([USER])
  isOnBoarded   Boolean @default(false)

  resetToken       String?
  resetTokenExpiry DateTime?

  quizzes QuizParticipant[] // student quizzes
  // requests Request[] // student requests to join quiz

  adminOf                 Group[]            @relation("GroupAdmin")
  quizCollaborations      QuizCollaborator[] @relation("QuizCollaboratorUser")
  quizCollaborationsAdded QuizCollaborator[] @relation("QuizCollaboratorAddedBy")
  imageLibrary            UserImage[]

  @@map("users")
}

model Group {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  slug          String?  @unique
  previousSlugs String[] @default([])
  name          String
  desc          String

  quizzes Quiz[] @relation("GroupQuizzes")
  adminId String @db.ObjectId
  admin   User   @relation("GroupAdmin", fields: [adminId], references: [id])

  QuizParticipants QuizParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, name])
  @@map("groups")
}

model QuizParticipant {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  userId           String  @db.ObjectId
  quizId           String  @db.ObjectId
  groupId          String  @db.ObjectId
  // Public quiz registrants are not authenticated user accounts. Preserve the
  // submitted identity on the attempt rather than binding an email to User.
  participantName  String?
  participantEmail String?
  participantPhone String?
  isQualified      Boolean @default(false)
  anyReason        String?
  sentEmailId      String?
  User             User    @relation(fields: [userId], references: [id])
  Quiz             Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Group            Group   @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  Answers    ParticipantQuizAnswer[]
  QuizInputs QuizInput[]
  createdAt  DateTime                @default(now())

  @@unique([userId, quizId])
  @@index([quizId, participantEmail])
  @@index([groupId, createdAt])
  @@map("quiz_participants")
}

model QuizInput {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  key               String
  value             String
  quizParticipantId String          @db.ObjectId
  QuizParticipant   QuizParticipant @relation(fields: [quizParticipantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("quiz_inputs")
}

model ParticipantQuizAnswer {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  answer            String
  questionId        String          @db.ObjectId
  Question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quizParticipantId String          @db.ObjectId
  QuizParticipant   QuizParticipant @relation(fields: [quizParticipantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([quizParticipantId, questionId])
  @@map("participant_quiz_answers")
}

model Quiz {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  // Optional during migration; new quizzes always receive a stable URL slug.
  slug          String?  @unique
  previousSlugs String[] @default([])
  title         String
  desc          String?
  duration      Int?
  maxMarks      Int?
  userInputs    String[]

  isStrictMode       Boolean @default(false)
  translationEnabled Boolean @default(false)
  sourceLanguage     String?
  targetLanguage     String?

  footerHeading1 String?
  footerHeading2 String?
  footerText1    String?
  footerText2    String?
  footerLink     String?

  author  String
  groupId String @db.ObjectId
  group   Group  @relation("GroupQuizzes", fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  participants  QuizParticipant[]
  questions     Question[]
  images        Image[]
  collaborators QuizCollaborator[]

  createdAt   DateTime  @default(now())
  published   Boolean   @default(false)
  publishedAt DateTime?

  // Shared availability affects every participant. This is separate from
  // `duration`, which remains the per-participant attempt timer.
  availabilityMode            QuizAvailabilityMode @default(ALWAYS)
  availabilityDurationMinutes Int?
  availabilityStartedAt       DateTime?
  availabilityStartsAt        DateTime?
  availabilityEndsAt          DateTime?

  @@unique([groupId, title])
  @@index([groupId, createdAt])
  @@map("quizzes")
}

model Question {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  translatedTitle String?
  showSnippet     Boolean @default(false)
  snippet         String?
  snippetLang     String?
  answer          String
  quizId          String  @db.ObjectId
  quiz            Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  options                Option[]
  participantQuizAnswers ParticipantQuizAnswer[]

  // @@unique([quizId, title])
  @@index([quizId])
  @@map("questions")
}

model Option {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  key             String
  value           String
  translatedValue String?
  questionId      String   @db.ObjectId
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([questionId, value])
  @@map("options")
}

model Image {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  key      String
  url      String
  publicId String
  quizId   String @db.ObjectId
  quiz     Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("images")
}

// A quiz is shared by adding collaborators; its primary admin is always
// derived from the owner of the quiz's folder and is never stored as removable data.
model QuizCollaborator {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quizId    String   @db.ObjectId
  userId    String   @db.ObjectId
  addedById String   @db.ObjectId
  Quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  User      User     @relation("QuizCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  AddedBy   User     @relation("QuizCollaboratorAddedBy", fields: [addedById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())

  @@unique([quizId, userId])
  @@index([userId, createdAt])
  @@map("quiz_collaborators")
}

// Personal Cloudinary library. Quiz image rows only reference the library item;
// deleting a quiz must not delete a reusable user image.
model UserImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  url       String
  publicId  String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, publicId])
  @@index([userId, createdAt])
  @@map("user_images")
}
